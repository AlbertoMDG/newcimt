# SQL Server
DB_HOST=NDCSQLB1
DB_USER=
DB_PASSWORD=
DB_NAME=CIMT

# API
PORT=3001

# Auth
# Bootstrap admin for `npm run db:seed-admin` (change the password after first login)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Set to true when serving over HTTPS so the session cookie is Secure
COOKIE_SECURE=false

# Incident encryption master key: 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK IT UP separately from SQL backups — encrypted chat/files are unrecoverable without it.
CIMT_MASTER_KEY=

# Where encrypted war-room documents are stored (default: server/private-files, outside the web root)
# CIMT_FILES_DIR=D:\cimt-files

# Only during a master-key rotation: the OLD key goes here while `npm run rotate:master-key`
# re-wraps every incident's data key under the new CIMT_MASTER_KEY. Remove afterwards.
# CIMT_MASTER_KEY_PREVIOUS=

# ---- Azure Entra ID SSO (see docs/sso.md) ----
# SSO activates automatically when all four are set.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:5173/api/auth/sso/callback
# Override the issuer only to test against a mock OIDC server (default: login.microsoftonline.com/<tenant>/v2.0)
# ENTRA_ISSUER=
# 'false' = only users pre-created in the admin can sign in via SSO (default: any tenant member gets a regular account)
# ENTRA_AUTO_PROVISION=
# 'false' = turn off email/password sign-in once SSO works (keep 'true' in dev as break-glass)
# AUTH_LOCAL_ENABLED=true
